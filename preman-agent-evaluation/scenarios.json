{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "chat_booking",
      "fixture": "booking",
      "modality": "chat",
      "turns": [
        {
          "type": "text",
          "text": "Book appointment for C1 at 2026-12-01T10:00:00Z"
        },
        {
          "type": "text",
          "text": "Yes, confirm"
        }
      ],
      "expect": {
        "booking": {
          "count": 1,
          "customer_id": "C1",
          "starts_at": "2026-12-01T10:00:00Z"
        }
      },
      "turn_timeout_ms": 3000
    },
    {
      "id": "chat_false_success",
      "fixture": "false_success",
      "modality": "chat",
      "turns": [
        {
          "type": "text",
          "text": "Book appointment for C1 at 2026-12-01T10:00:00Z"
        },
        {
          "type": "text",
          "text": "Yes, confirm"
        }
      ],
      "expect": {
        "booking": {
          "count": 1,
          "customer_id": "C1",
          "starts_at": "2026-12-01T10:00:00Z"
        }
      },
      "turn_timeout_ms": 3000
    },
    {
      "id": "chat_retry",
      "fixture": "retry",
      "modality": "chat",
      "turns": [
        {
          "type": "text",
          "text": "Book appointment for C1 at 2026-12-01T10:00:00Z"
        },
        {
          "type": "text",
          "text": "Yes, confirm"
        }
      ],
      "expect": {
        "booking": {
          "count": 1,
          "customer_id": "C1",
          "starts_at": "2026-12-01T10:00:00Z"
        }
      },
      "turn_timeout_ms": 3000
    },
    {
      "id": "chat_unconfirmed_address",
      "fixture": "address",
      "modality": "chat",
      "turns": [
        {
          "type": "text",
          "text": "Change it to 14 Pine Street. Ask me before saving."
        }
      ],
      "expect": {
        "address": "10 Oak Street",
        "no_write_without_confirmation": true
      },
      "turn_timeout_ms": 3000
    },
    {
      "id": "chat_state_error",
      "fixture": "state_unavailable",
      "modality": "chat",
      "turns": [
        {
          "type": "text",
          "text": "Book appointment for C1 at 2026-12-01T10:00:00Z"
        },
        {
          "type": "text",
          "text": "Yes, confirm"
        }
      ],
      "expect": {
        "booking": {
          "count": 1,
          "customer_id": "C1",
          "starts_at": "2026-12-01T10:00:00Z"
        }
      },
      "turn_timeout_ms": 3000
    },
    {
      "id": "chat_timeout",
      "fixture": "slow",
      "modality": "chat",
      "turn_timeout_ms": 400,
      "turns": [
        {
          "type": "text",
          "text": "Book appointment for C1 at 2026-12-01T10:00:00Z"
        }
      ],
      "expect": {
        "booking": {
          "count": 0
        }
      }
    },
    {
      "id": "audio_booking",
      "fixture": "booking",
      "modality": "audio",
      "turns": [
        {
          "type": "audio",
          "path": "fixtures/audio/booking_request.wav"
        },
        {
          "type": "audio",
          "path": "fixtures/audio/confirm.wav"
        }
      ],
      "expect": {
        "booking": {
          "count": 1,
          "customer_id": "C1",
          "starts_at": "2026-12-01T10:00:00Z"
        },
        "max_first_audio_playback_ms": 1000
      },
      "turn_timeout_ms": 3000
    },
    {
      "id": "audio_interruption",
      "fixture": "address",
      "modality": "audio",
      "turns": [
        {
          "type": "audio",
          "path": "fixtures/audio/address_request.wav"
        },
        {
          "type": "interrupt"
        },
        {
          "type": "audio",
          "path": "fixtures/audio/correction.wav"
        }
      ],
      "expect": {
        "address": "10 Oak Street",
        "no_write_without_confirmation": true,
        "max_first_audio_playback_ms": 1000,
        "max_interruption_stop_ms": 400
      },
      "turn_timeout_ms": 3000
    }
  ]
}
